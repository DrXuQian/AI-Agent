# ---- Binaries / venvs (re-downloaded by install script) ----
prometheus/
grafana/
vllm-env/

# ---- Runtime data (generated by experiments) ----
results/prometheus-data/
results/*.log
results/.*.pid
results/vllm-server.log
phase2/runs/*.log
phase2/workspaces/

# ---- Test repo state (gets re-initialized per run) ----
cc-test-repo/.git/
cc-test-repo/__pycache__/

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
*.swp

# ---- vLLM / model artifacts (huge) ----
*.safetensors
*.bin
*.pt
